POSTGRES_DB=doctor_wang
POSTGRES_USER=doctor_wang
POSTGRES_PASSWORD=replace-with-a-unique-strong-database-password
APP_AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
APP_AUTH_JWT_ISSUER=doctor-wang-backend
APP_AUTH_JWT_AUDIENCE=doctor-wang-android
APP_AUTH_JWT_TTL_SECONDS=3600
SERVER_PUBLIC_BASE_URL=https://your-domain.example
# Absolute host path containing fullchain.pem and privkey.pem. Do not store this directory in Git.
TLS_CERTS_DIR=/absolute/path/to/doctor-wang-tls
AI_SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
REPORT_PROCESSING_WORKER_ENABLED=false
