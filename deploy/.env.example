POSTGRES_DB=doctor_wang
POSTGRES_USER=doctor_wang
POSTGRES_PASSWORD=replace-with-a-unique-strong-database-password
APP_AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
APP_AUTH_JWT_ISSUER=doctor-wang-backend
APP_AUTH_JWT_AUDIENCE=doctor-wang-android
APP_AUTH_JWT_TTL_SECONDS=3600
SERVER_PUBLIC_BASE_URL=https://your-domain.example
# Absolute host path containing fullchain.pem and privkey.pem. Do not store this directory in Git.
TLS_CERTS_DIR=/absolute/path/to/doctor-wang-tls
AI_SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
# AI provider (real LLM/embeddings). Keys are secrets: never commit, use secrets management.
# LLM generation (e.g. DeepSeek OpenAI-compatible):
AI_SERVICE_ENABLED=true
DW_AI_LLM_ENDPOINT=https://api.deepseek.com/chat/completions
DW_AI_LLM_API_KEY=replace-with-llm-api-key
DW_AI_LLM_MODEL=deepseek-v4-flash
# Real embeddings (e.g. Zhipu BigModel OpenAI-compatible /embeddings):
DW_AI_EMBEDDING_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/embeddings
DW_AI_EMBEDDING_API_KEY=replace-with-embedding-api-key
DW_AI_EMBEDDING_MODEL=embedding-3
DW_AI_EMBEDDING_DIMENSIONS=2048
# Virus scan (SEC-001/ADR-0008): enable + point at ClamAV clamd endpoint when orchestrated.
VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_HOST=clamav
VIRUS_SCAN_PORT=3310
REPORT_PROCESSING_WORKER_ENABLED=false
